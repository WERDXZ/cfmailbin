{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run --watch --allow-env --allow-net src/main.ts",
    "ui:dev": "deno run -A npm:vite --config vite.config.ts",
    "ui:build": "deno run -A npm:vite build --config vite.config.ts",
    "ui:preview": "deno run -A npm:vite preview --config vite.config.ts",
    "check": "deno check src/main.ts src/worker.ts src/ui/main.tsx tests/*.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "test": "deno test"
  },
  "imports": {
    "@preact/preset-vite": "npm:@preact/preset-vite@2.10.5",
    "@std/assert": "jsr:@std/assert@1",
    "preact": "npm:preact@10.29.1",
    "preact/hooks": "npm:preact@10.29.1/hooks",
    "preact/jsx-dev-runtime": "npm:preact@10.29.1/jsx-dev-runtime",
    "preact/jsx-runtime": "npm:preact@10.29.1/jsx-runtime",
    "vite": "npm:vite@8.0.10"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true
  }
}
